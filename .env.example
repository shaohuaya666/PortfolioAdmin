# 阿里云容器镜像服务配置
# 请替换为你的实际镜像仓库地址
ALIYUN_REGISTRY=crpi-y4pk2uzkfo2ssnje.cn-hangzhou.personal.cr.aliyuncs.com

# 数据库连接字符串（与 BlazorPortfolio 共用同一个库）
DB_CONNECTION_STRING=Server=your_mysql_host;Port=3306;Database=BlazorPortfolio;User=your_user;Password=your_password;

# JWT 配置（变量名对应 Program.cs 读取的 Jwt:SecretKey / Jwt:Issuer / Jwt:Audience）
JWT_SECRET=your_super_secret_key_min_32_characters
JWT_ISSUER=PortfolioAdmin
JWT_AUDIENCE=PortfolioAdmin

# 前台站点（BlazorPortfolio）缓存失效配置
# 必须与 BlazorPortfolio 的 appsettings.Production.json 中 Cache 节点逐项一致，
# 不一致时删除的键名不同，Redis 返回"删除 0 个键"且不报错（静默失效）。
CACHE_ENABLED=true
CACHE_KEY_PREFIX=BlazorPortfolio
CACHE_KEY_VERSION=v1
# 主机名 redis 依赖 cache-net 外部网络；Redis 开了 requirepass 时必须带 password=
REDIS_CONNECTION_STRING=redis:6379,password=your_redis_password
REDIS_DATABASE=0

# 部署镜像标签（可选，CI 会自动传入 git sha 用于回滚，手动留空即用 latest）
# IMAGE_TAG=
